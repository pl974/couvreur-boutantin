---
/**
 * Page index du blog
 * Liste tous les articles classes par date
 * Optimise pour le SEO longue traine
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BlogCard from '../../components/BlogCard.astro';
import Button from '../../components/Button.astro';
import { blogArticles } from '../../utils/seo';

// Trier les articles par date (plus recent en premier)
const sortedArticles = [...blogArticles].sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<BaseLayout
  title="Blog couvreur - Conseils et actualites toiture"
  description="Conseils d'experts sur l'entretien, la reparation et la renovation de toiture. Guides pratiques et actualites du metier de couvreur."
>
  <Breadcrumb items={[{ label: 'Blog' }]} />

  <section class="page-header">
    <div class="page-header-bg" style="background-image: url('/images/hero/hero-toiture-dunkerque.webp')"></div>
    <div class="page-header-overlay"></div>
    <div class="container">
      <h1>Blog et conseils toiture</h1>
      <p>
        Retrouvez nos articles, guides pratiques et conseils d'experts pour
        entretenir, reparer et renover votre toiture.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {sortedArticles.map(article => (
          <BlogCard
            title={article.title}
            excerpt={article.excerpt}
            image={article.image}
            slug={article.slug}
            date={article.date}
            category={article.category}
            readTime={article.readTime}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="blog-cta">
        <h2>Une question sur votre toiture ?</h2>
        <p>
          Nos experts sont a votre disposition pour repondre a toutes vos
          questions et vous conseiller sur vos projets de toiture.
        </p>
        <div class="cta-buttons">
          <Button href="tel:+33328000000" variant="primary" size="lg">
            Appeler le 03 28 00 00 00
          </Button>
          <Button href="/contact/" variant="secondary" size="lg">
            Demander un devis
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    color: var(--color-white);
    padding: var(--spacing-3xl) 0;
    text-align: center;
    min-height: 300px;
    display: flex;
    align-items: center;
  }

  .page-header-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .page-header-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(30, 58, 95, 0.92) 0%, rgba(30, 58, 95, 0.85) 100%);
    z-index: 1;
  }

  .page-header .container {
    position: relative;
    z-index: 2;
  }

  .page-header h1 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .page-header p {
    color: var(--color-gray-200);
    max-width: 600px;
    margin: 0 auto;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-xl);
  }

  .cta-section {
    background-color: var(--color-primary);
  }

  .blog-cta {
    text-align: center;
    color: var(--color-white);
  }

  .blog-cta h2 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .blog-cta p {
    color: var(--color-gray-200);
    margin-bottom: var(--spacing-xl);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
