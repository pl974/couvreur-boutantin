---
/**
 * Template dynamique pour les articles de blog
 * Supporte le contenu riche avec H2, H3, listes, tableaux
 * Schema Article pour SEO position 0
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BlogCard from '../../components/BlogCard.astro';
import Button from '../../components/Button.astro';
import { blogArticles, generateArticleSchema } from '../../utils/seo';

export function getStaticPaths() {
  return blogArticles.map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

// Articles similaires
const relatedArticles = blogArticles
  .filter(a => a.category === article.category && a.slug !== article.slug)
  .slice(0, 2);

const otherArticles = relatedArticles.length < 2
  ? blogArticles.filter(a => a.slug !== article.slug && !relatedArticles.includes(a)).slice(0, 2 - relatedArticles.length)
  : [];
const displayedArticles = [...relatedArticles, ...otherArticles];

const formattedDate = new Date(article.date).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const structuredData = generateArticleSchema({
  title: article.title,
  description: article.description,
  image: article.image,
  date: article.date,
  slug: article.slug
});
---

<BaseLayout
  title={article.title}
  description={article.description}
  structuredData={structuredData}
>
  <Breadcrumb items={[
    { label: 'Blog', href: '/blog/' },
    { label: article.title }
  ]} />

  <article class="blog-article">
    <header class="article-header">
      <div class="container">
        <div class="article-meta">
          <span class="article-category">{article.category}</span>
          <time datetime={article.date}>{formattedDate}</time>
          <span class="article-readtime">{article.readTime} de lecture</span>
        </div>
        <h1>{article.title}</h1>
        <p class="article-excerpt">{article.excerpt}</p>
      </div>
    </header>

    <div class="article-image">
      <div class="container">
        <img
          src={article.image}
          alt={article.title}
          width="1200"
          height="600"
          loading="eager"
        />
      </div>
    </div>

    <div class="article-content">
      <div class="container">
        <div class="content-grid">
          <div class="main-content" set:html={article.content} />

          <aside class="article-sidebar">
            <div class="sidebar-box">
              <h3>Besoin d'un expert ?</h3>
              <p>
                Nos couvreurs professionnels interviennent a Dunkerque
                et sur tout le littoral nord.
              </p>
              <Button href="tel:+33328000000" variant="primary" fullWidth={true}>
                Appeler maintenant
              </Button>
              <Button href="/contact/" variant="outline" fullWidth={true}>
                Demander un devis
              </Button>
            </div>

            <div class="sidebar-box sidebar-services">
              <h3>Nos services</h3>
              <ul>
                <li><a href="/services/reparation-toiture/">Reparation toiture</a></li>
                <li><a href="/services/renovation-toiture/">Renovation toiture</a></li>
                <li><a href="/services/demoussage/">Demoussage</a></li>
                <li><a href="/services/zinguerie/">Zinguerie</a></li>
                <li><a href="/services/isolation/">Isolation</a></li>
                <li><a href="/services/urgence/">Urgence 24/7</a></li>
              </ul>
            </div>

            <div class="sidebar-box sidebar-zones">
              <h3>Zones d'intervention</h3>
              <ul>
                <li><a href="/zones/dunkerque/">Dunkerque</a></li>
                <li><a href="/zones/calais/">Calais</a></li>
                <li><a href="/zones/gravelines/">Gravelines</a></li>
                <li><a href="/zones/grande-synthe/">Grande-Synthe</a></li>
                <li><a href="/zones/coudekerque/">Coudekerque-Branche</a></li>
                <li><a href="/zones/saint-pol-sur-mer/">Saint-Pol-sur-Mer</a></li>
                <li><a href="/zones/bray-dunes/">Bray-Dunes</a></li>
                <li><a href="/zones/loon-plage/">Loon-Plage</a></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </article>

  {displayedArticles.length > 0 && (
    <section class="section related-articles">
      <div class="container">
        <h2>Articles similaires</h2>
        <div class="related-grid">
          {displayedArticles.map(related => (
            <BlogCard
              title={related.title}
              excerpt={related.excerpt}
              image={related.image}
              slug={related.slug}
              date={related.date}
              category={related.category}
              readTime={related.readTime}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section cta-section">
    <div class="container">
      <div class="article-cta">
        <h2>Un projet de toiture ?</h2>
        <p>
          Contactez-nous pour un devis gratuit. Reponse sous 24h.
        </p>
        <div class="cta-buttons">
          <Button href="tel:+33328000000" variant="primary" size="lg">
            Appeler le 03 28 00 00 00
          </Button>
          <Button href="/contact/" variant="secondary" size="lg">
            Formulaire de contact
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-header {
    padding: var(--spacing-3xl) 0 var(--spacing-xl);
    background-color: var(--color-gray-50);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
    font-size: var(--text-sm);
    color: var(--color-gray-600);
  }

  .article-category {
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--text-xs);
  }

  .article-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--spacing-md);
    max-width: 800px;
  }

  .article-excerpt {
    font-size: var(--text-lg);
    color: var(--color-gray-600);
    max-width: 700px;
    line-height: 1.7;
  }

  .article-image {
    margin-top: calc(var(--spacing-xl) * -1);
  }

  .article-image img {
    width: 100%;
    max-width: 900px;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
  }

  .article-content {
    padding: var(--spacing-3xl) 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  /* Styles pour le contenu dynamique */
  .main-content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-gray-900);
  }

  .main-content :global(h2:first-child) {
    margin-top: 0;
  }

  .main-content :global(h3) {
    font-size: var(--text-xl);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
    color: var(--color-gray-800);
  }

  .main-content :global(p) {
    color: var(--color-gray-700);
    line-height: 1.8;
    margin-bottom: var(--spacing-md);
  }

  .main-content :global(ul),
  .main-content :global(ol) {
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
  }

  .main-content :global(li) {
    color: var(--color-gray-700);
    line-height: 1.7;
    padding: var(--spacing-xs) 0;
  }

  .main-content :global(strong) {
    color: var(--color-gray-900);
    font-weight: 600;
  }

  .main-content :global(blockquote) {
    border-left: 4px solid var(--color-secondary);
    padding-left: var(--spacing-lg);
    margin: var(--spacing-xl) 0;
    font-style: italic;
    color: var(--color-gray-600);
    font-size: var(--text-lg);
  }

  .main-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--spacing-xl) 0;
    font-size: var(--text-sm);
  }

  .main-content :global(th),
  .main-content :global(td) {
    padding: var(--spacing-sm) var(--spacing-md);
    border: 1px solid var(--color-gray-200);
    text-align: left;
  }

  .main-content :global(th) {
    background-color: var(--color-primary);
    color: var(--color-white);
    font-weight: 600;
  }

  .main-content :global(tr:nth-child(even)) {
    background-color: var(--color-gray-50);
  }

  .main-content :global(.info-box) {
    background-color: var(--color-gray-50);
    border-left: 4px solid var(--color-primary);
    padding: var(--spacing-lg);
    margin: var(--spacing-xl) 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .main-content :global(.info-box p) {
    margin: 0;
  }

  .main-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .main-content :global(a:hover) {
    color: var(--color-secondary);
  }

  .article-sidebar {
    position: sticky;
    top: 100px;
  }

  .sidebar-box {
    background-color: var(--color-gray-50);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
  }

  .sidebar-box h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-md);
  }

  .sidebar-box p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-md);
  }

  .sidebar-box :global(.btn) {
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-services ul,
  .sidebar-zones ul {
    list-style: none;
    padding: 0;
  }

  .sidebar-services li,
  .sidebar-zones li {
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .sidebar-services li:last-child,
  .sidebar-zones li:last-child {
    border-bottom: none;
  }

  .sidebar-services a,
  .sidebar-zones a {
    color: var(--color-gray-700);
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .sidebar-services a:hover,
  .sidebar-zones a:hover {
    color: var(--color-primary);
  }

  .related-articles {
    background-color: var(--color-gray-50);
  }

  .related-articles h2 {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-xl);
    max-width: 800px;
    margin: 0 auto;
  }

  .cta-section {
    background-color: var(--color-primary);
  }

  .article-cta {
    text-align: center;
    color: var(--color-white);
  }

  .article-cta h2 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .article-cta p {
    color: var(--color-gray-200);
    margin-bottom: var(--spacing-xl);
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .article-header h1 {
      font-size: var(--text-3xl);
    }

    .article-meta {
      flex-wrap: wrap;
    }
  }
</style>
