---
/**
 * Template dynamique pour les pages de villes
 * Genere une page pour chaque zone d'intervention
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import FAQ from '../../components/FAQ.astro';
import Button from '../../components/Button.astro';
import Gallery from '../../components/Gallery.astro';
import { cities, services, generateCitySchema } from '../../utils/seo';

export function getStaticPaths() {
  return cities.map(city => ({
    params: { slug: city.slug },
    props: { city }
  }));
}

const { city } = Astro.props;

// Galerie de realisations par ville
const cityGalleries: Record<string, Array<{before: string; after: string; title: string; description: string}>> = {
  'dunkerque': [
    {
      before: '/images/gallery/realisation-01-avant.webp',
      after: '/images/gallery/realisation-01-apres.webp',
      title: 'Renovation toiture Dunkerque centre',
      description: 'Renovation complete maison de ville. Quartier centre-ville.'
    },
    {
      before: '/images/gallery/realisation-02-avant.webp',
      after: '/images/gallery/realisation-02-apres.webp',
      title: 'Demoussage villa Malo-les-Bains',
      description: 'Traitement anti-mousse et hydrofuge. Secteur Malo-les-Bains.'
    }
  ],
  'calais': [
    {
      before: '/images/gallery/realisation-01-avant.webp',
      after: '/images/gallery/realisation-01-apres.webp',
      title: 'Renovation toiture Calais',
      description: 'Remplacement couverture maison individuelle a Calais.'
    }
  ],
  'gravelines': [
    {
      before: '/images/gallery/realisation-03-avant.webp',
      after: '/images/gallery/realisation-03-apres.webp',
      title: 'Zinguerie Gravelines',
      description: 'Remplacement gouttieres et faitages a Gravelines.'
    }
  ],
  'grande-synthe': [
    {
      before: '/images/gallery/realisation-02-avant.webp',
      after: '/images/gallery/realisation-02-apres.webp',
      title: 'Toiture Grande-Synthe',
      description: 'Intervention complete a Grande-Synthe.'
    }
  ]
};

const galleryItems = cityGalleries[city.slug] || [
  {
    before: '/images/gallery/realisation-01-avant.webp',
    after: '/images/gallery/realisation-01-apres.webp',
    title: `Intervention a ${city.name}`,
    description: `Exemple de nos realisations a ${city.name} et communes voisines.`
  }
];

// FAQ pour les pages de villes
const faqItems = [
  {
    question: `Quels services proposez-vous a ${city.name} ?`,
    answer: `Nous proposons tous nos services de couverture a ${city.name} : reparation de toiture, renovation complete, demoussage, zinguerie, isolation et intervention d'urgence. Tous nos travaux sont realises par des artisans qualifies.`
  },
  {
    question: `Quel est le delai d'intervention a ${city.name} ?`,
    answer: `Pour les demandes standard, nous proposons un devis sous 24h et une intervention sous quelques jours. En cas d'urgence (fuite, degats tempete), nous pouvons intervenir dans les 24 a 48h.`
  },
  {
    question: `Le deplacement est-il facture a ${city.name} ?`,
    answer: `Non, le deplacement et le devis sont entierement gratuits et sans engagement. Nous intervenons regulierement a ${city.name} et dans les communes voisines.`
  },
  {
    question: `Etes-vous assure pour les travaux a ${city.name} ?`,
    answer: `Oui, nous disposons d'une garantie decennale et d'une assurance responsabilite civile professionnelle qui couvrent tous nos travaux, quelle que soit la commune d'intervention.`
  }
];

const structuredData = generateCitySchema({
  name: city.name,
  postalCode: city.postalCode,
  description: city.description,
  url: `https://couvreur-boutantin.fr/zones/${city.slug}/`
});
---

<BaseLayout
  title={city.title}
  description={city.description}
  structuredData={structuredData}
>
  <section class="page-header">
    <div class="page-header-bg" style={`background-image: url(${city.image})`}></div>
    <div class="page-header-overlay"></div>
    <div class="container">
      <div class="header-content">
        <span class="city-badge">{city.postalCode}</span>
        <h1>{city.title}</h1>
        <p>{city.shortDescription}</p>
        <div class="header-cta">
          <Button href="tel:+33328000000" variant="primary" size="lg">
            Appeler maintenant
          </Button>
          <Button href="#devis" variant="outline" size="lg">
            Demander un devis
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Image de la ville -->
  <section class="city-image-section">
    <div class="container">
      <div class="city-image-wrapper">
        <img
          src={city.image}
          alt={`${city.name} - Zone d'intervention Couvreur Boutantin`}
          width="1200"
          height="500"
          loading="eager"
        />
        <div class="city-image-overlay">
          <h2>Couvreur a {city.name} ({city.postalCode})</h2>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-grid">
        <div class="main-content">
          <h2>Votre couvreur professionnel a {city.name}</h2>

          <p>
            <strong>Couvreur Boutantin</strong> intervient regulierement a {city.name}
            ({city.postalCode}) pour tous types de travaux de toiture. Notre equipe
            de couvreurs qualifies met son expertise au service des habitants de la
            commune pour des prestations de qualite.
          </p>

          <p>
            Que vous ayez besoin d'une reparation suite a une fuite, d'un demoussage
            pour entretenir votre couverture ou d'une renovation complete, nous vous
            proposons des solutions adaptees a vos besoins et votre budget.
          </p>

          <h3>Nos services a {city.name}</h3>

          <div class="services-grid">
            {services.slice(0, 4).map(service => (
              <ServiceCard
                title={service.name}
                description={service.shortDescription}
                icon={service.icon}
                href={`/services/${service.slug}/`}
              />
            ))}
          </div>

          <div class="all-services-link">
            <Button href="/services/" variant="outline">
              Voir tous nos services
            </Button>
          </div>

          <h3>Pourquoi choisir Couvreur Boutantin a {city.name} ?</h3>

          <ul class="benefits-list">
            <li>
              <strong>Proximite</strong> - Intervention rapide grace a notre implantation
              locale dans la region dunkerquoise
            </li>
            <li>
              <strong>Expertise</strong> - Connaissance des toitures de la region et
              des contraintes climatiques du littoral
            </li>
            <li>
              <strong>Qualite</strong> - Travaux realises dans les regles de l'art par
              des artisans qualifies
            </li>
            <li>
              <strong>Garanties</strong> - Garantie decennale et assurance RC Pro pour
              votre tranquillite
            </li>
            <li>
              <strong>Prix justes</strong> - Devis detaille et transparent, sans mauvaise
              surprise
            </li>
          </ul>

          <h3>Comment obtenir un devis a {city.name} ?</h3>

          <p>
            Contactez-nous par telephone au <a href="tel:+33328000000">03 28 00 00 00</a>
            ou remplissez notre formulaire en ligne. Nous vous recontactons sous 24h
            pour convenir d'un rendez-vous. Le deplacement et le devis sont gratuits
            et sans engagement.
          </p>

          <p>
            Lors de notre visite, nous evaluons l'etat de votre toiture, identifions
            les travaux necessaires et vous proposons un devis detaille avec les
            differentes options possibles.
          </p>
        </div>

        <aside class="sidebar">
          <div class="contact-box" id="devis">
            <ContactForm compact={true} title={`Devis gratuit a ${city.name}`} />
          </div>

          <div class="info-box">
            <h4>Intervention rapide</h4>
            <p>Appelez-nous directement :</p>
            <a href="tel:+33328000000" class="phone-link">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              03 28 00 00 00
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Realisations locales -->
  <Gallery
    items={galleryItems}
    title={`Nos realisations a ${city.name}`}
    subtitle="Exemples de nos interventions dans votre commune"
  />

  <!-- FAQ -->
  <section class="section faq-section">
    <div class="container">
      <FAQ items={faqItems} title={`Questions frequentes - Couvreur a ${city.name}`} />
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="final-cta">
        <h2>Besoin d'un couvreur a {city.name} ?</h2>
        <p>
          Contactez-nous des maintenant pour obtenir votre devis gratuit.
          Notre equipe intervient rapidement sur {city.name} et les communes voisines.
        </p>
        <div class="cta-buttons">
          <Button href="tel:+33328000000" variant="primary" size="lg">
            Appeler le 03 28 00 00 00
          </Button>
          <Button href="/contact/" variant="secondary" size="lg">
            Formulaire de contact
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .city-image-section {
    padding: 0;
    position: relative;
  }

  .city-image-wrapper {
    max-width: var(--container-max);
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .city-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 400px;
  }

  .city-image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-xl) var(--container-padding);
    background: linear-gradient(to top, rgba(30, 58, 95, 0.9), transparent);
  }

  .city-image-overlay h2 {
    color: var(--color-white);
    font-size: var(--text-3xl);
    margin: 0;
  }

  .page-header {
    position: relative;
    color: var(--color-white);
    padding: var(--spacing-3xl) 0;
    text-align: center;
    min-height: 350px;
    display: flex;
    align-items: center;
  }

  .page-header-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
  }

  .page-header-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(30, 58, 95, 0.92) 0%, rgba(30, 58, 95, 0.85) 100%);
    z-index: 1;
  }

  .page-header .container {
    position: relative;
    z-index: 2;
  }

  .header-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .city-badge {
    display: inline-block;
    background-color: var(--color-secondary);
    color: var(--color-gray-900);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-md);
  }

  .page-header h1 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .page-header p {
    color: var(--color-gray-200);
    margin-bottom: var(--spacing-xl);
  }

  .header-cta {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .header-cta .btn-outline {
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .header-cta .btn-outline:hover {
    background-color: var(--color-white);
    color: var(--color-primary);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  .main-content h2 {
    margin-bottom: var(--spacing-lg);
  }

  .main-content h3 {
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .main-content p {
    color: var(--color-gray-700);
    line-height: 1.8;
  }

  .main-content a {
    color: var(--color-primary);
    font-weight: 500;
  }

  .main-content a:hover {
    color: var(--color-secondary);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    margin: var(--spacing-lg) 0;
  }

  .all-services-link {
    text-align: center;
    margin-top: var(--spacing-lg);
  }

  .benefits-list {
    padding-left: var(--spacing-lg);
    margin: var(--spacing-lg) 0;
  }

  .benefits-list li {
    padding: var(--spacing-sm) 0;
    color: var(--color-gray-700);
    line-height: 1.6;
  }

  .benefits-list strong {
    color: var(--color-gray-900);
  }

  .sidebar {
    position: sticky;
    top: 100px;
  }

  .contact-box {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    margin-bottom: var(--spacing-lg);
    box-shadow: var(--shadow-md);
  }

  .info-box {
    background-color: var(--color-gray-50);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    text-align: center;
  }

  .info-box h4 {
    font-size: var(--text-base);
    margin-bottom: var(--spacing-sm);
  }

  .info-box p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-md);
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-primary);
  }

  .phone-link:hover {
    color: var(--color-secondary);
  }

  .faq-section {
    background-color: var(--color-gray-50);
  }

  .cta-section {
    background-color: var(--color-primary);
  }

  .final-cta {
    text-align: center;
    color: var(--color-white);
  }

  .final-cta h2 {
    color: var(--color-white);
    margin-bottom: var(--spacing-md);
  }

  .final-cta p {
    color: var(--color-gray-200);
    margin-bottom: var(--spacing-xl);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .sidebar {
      position: static;
    }

    .contact-box {
      max-width: 500px;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
