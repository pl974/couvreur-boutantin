---
/**
 * Composant CityCardImage - Carte de zone avec image
 * Version enrichie avec image de ville/quartier
 * Optimise pour le SEO local et la conversion
 */

interface Props {
  name: string;
  description: string;
  image: string;
  href: string;
  postalCode?: string;
}

const { name, description, image, href, postalCode } = Astro.props;
---

<article class="city-card-image">
  <a href={href} class="city-link">
    <div class="city-image">
      <img src={image} alt={`Couvreur a ${name}`} loading="lazy" />
      <div class="city-overlay"></div>
      <div class="city-info-overlay">
        <h3>
          {name}
          {postalCode && <span class="postal-code">{postalCode}</span>}
        </h3>
      </div>
    </div>
    <div class="city-content">
      <p>{description}</p>
      <span class="city-cta">
        Voir nos services
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .city-card-image {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .city-card-image:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .city-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .city-image {
    position: relative;
    height: 180px;
    overflow: hidden;
  }

  .city-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .city-card-image:hover .city-image img {
    transform: scale(1.05);
  }

  .city-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, rgba(30, 58, 95, 0.8) 100%);
  }

  .city-info-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-md);
  }

  .city-info-overlay h3 {
    color: var(--color-white);
    font-size: var(--text-xl);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin: 0;
  }

  .postal-code {
    font-size: var(--text-sm);
    font-weight: 400;
    opacity: 0.8;
  }

  .city-content {
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .city-card-image p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--spacing-sm);
  }

  .city-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-secondary);
  }

  .city-cta svg {
    transition: transform var(--transition-fast);
  }

  .city-card-image:hover .city-cta svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .city-image {
      height: 140px;
    }
  }
</style>
