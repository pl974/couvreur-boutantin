---
/**
 * Composant ServiceCardImage - Carte de service avec image
 * Version enrichie visuellement avec image de fond
 * Optimise pour la conversion et l'engagement utilisateur
 */

interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
  badge?: string;
}

const { title, description, image, href, badge } = Astro.props;
---

<article class="service-card-image">
  <a href={href} class="service-link">
    <div class="service-image">
      <img src={image} alt={title} loading="lazy" />
      <div class="service-overlay"></div>
      {badge && <span class="service-badge">{badge}</span>}
    </div>
    <div class="service-content">
      <h3>{title}</h3>
      <p>{description}</p>
      <span class="service-cta">
        Decouvrir
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .service-card-image {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .service-card-image:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .service-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .service-image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .service-card-image:hover .service-image img {
    transform: scale(1.05);
  }

  .service-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(30, 58, 95, 0.4) 100%);
    transition: opacity var(--transition-base);
  }

  .service-card-image:hover .service-overlay {
    opacity: 0.8;
  }

  .service-badge {
    position: absolute;
    top: var(--spacing-md);
    right: var(--spacing-md);
    background-color: var(--color-secondary);
    color: var(--color-gray-900);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .service-content {
    padding: var(--spacing-lg);
  }

  .service-card-image h3 {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .service-card-image p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-secondary);
    transition: color var(--transition-fast);
  }

  .service-cta svg {
    transition: transform var(--transition-fast);
  }

  .service-card-image:hover .service-cta {
    color: var(--color-primary);
  }

  .service-card-image:hover .service-cta svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .service-image {
      height: 160px;
    }
  }
</style>
