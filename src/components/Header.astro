---
/**
 * Composant Header - Navigation principale
 * Inclut le logo, la navigation et le CTA téléphone
 */

import Button from './Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/services/', label: 'Services' },
  { href: '/zones/', label: 'Zones' },
  { href: '/contact/', label: 'Contact' }
];
---

<header class="header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="Couvreur Boutantin - Accueil">
        <span class="logo-text">Couvreur</span>
        <span class="logo-accent">Boutantin</span>
      </a>

      <a href="tel:+33328000000" class="urgence-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Urgence 24/7</span>
      </a>

      <nav class="nav" aria-label="Navigation principale">
        <ul class="nav-list">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: currentPath === link.href }]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="header-cta">
        <a href="tel:+33328000000" class="phone-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>03 28 00 00 00</span>
        </a>
        <Button href="/contact/" variant="primary" size="sm">
          Devis gratuit
        </Button>
      </div>

      <button class="menu-toggle" aria-label="Menu" aria-expanded="false">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md) 0;
    gap: var(--spacing-lg);
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
  }

  .logo-accent {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .urgence-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 2px 8px rgba(220, 38, 38, 0.3);
    animation: pulse-urgence 2s ease-in-out infinite;
  }

  .urgence-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
  }

  .urgence-badge svg {
    animation: rotate-clock 4s linear infinite;
  }

  @keyframes pulse-urgence {
    0%, 100% {
      box-shadow: 0 2px 8px rgba(220, 38, 38, 0.3);
    }
    50% {
      box-shadow: 0 2px 16px rgba(220, 38, 38, 0.5);
    }
  }

  @keyframes rotate-clock {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .nav-list {
    display: flex;
    gap: var(--spacing-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    font-weight: 500;
    color: var(--color-gray-700);
    padding: var(--spacing-sm) 0;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-secondary);
    transition: width var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .phone-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-weight: 600;
    color: var(--color-primary);
  }

  .phone-link:hover {
    color: var(--color-secondary);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: var(--spacing-sm);
    background: none;
    border: none;
    cursor: pointer;
  }

  .menu-bar {
    width: 24px;
    height: 2px;
    background-color: var(--color-gray-800);
    transition: all var(--transition-fast);
  }

  @media (max-width: 1024px) {
    .nav {
      display: none;
    }

    .header-cta .phone-link span {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .urgence-badge {
      font-size: var(--text-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
    }
  }

  @media (max-width: 480px) {
    .header-cta button {
      display: none;
    }

    .urgence-badge span {
      display: none;
    }

    .urgence-badge {
      padding: var(--spacing-xs);
      width: 36px;
      height: 36px;
      justify-content: center;
    }
  }
</style>

<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('.nav');

  menuToggle?.addEventListener('click', () => {
    const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('open');
  });
</script>
