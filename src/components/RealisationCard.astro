---
/**
 * Composant RealisationCard
 * Carte d'apercu pour une realisation/etude de cas
 * Affiche avant/apres avec effet de comparaison
 */

interface Props {
  title: string;
  shortDescription: string;
  location: string;
  beforeImage: string;
  afterImage: string;
  services: string[];
  slug?: string;
  budget?: string;
}

const {
  title,
  shortDescription,
  location,
  beforeImage,
  afterImage,
  services,
  slug,
  budget
} = Astro.props;
---

<article class="realisation-card">
  <div class="realisation-images">
    <div class="image-comparison">
      <div class="image-before">
        <img src={beforeImage} alt={`${title} - Avant`} width="400" height="300" loading="lazy" />
        <span class="image-label">Avant</span>
      </div>
      <div class="image-after">
        <img src={afterImage} alt={`${title} - Apres`} width="400" height="300" loading="lazy" />
        <span class="image-label">Apres</span>
      </div>
    </div>
  </div>

  <div class="realisation-content">
    <div class="realisation-location">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
      {location}
    </div>

    <h3 class="realisation-title">{title}</h3>
    <p class="realisation-description">{shortDescription}</p>

    <div class="realisation-services">
      {services.map(service => (
        <span class="service-tag">{service}</span>
      ))}
    </div>

    {budget && (
      <div class="realisation-budget">
        Budget indicatif : {budget} EUR
      </div>
    )}

    {slug && (
      <a href={`/realisations/${slug}/`} class="realisation-link">
        Voir le detail
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    )}
  </div>
</article>

<style>
  .realisation-card {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .realisation-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .realisation-images {
    position: relative;
  }

  .image-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .image-before,
  .image-after {
    position: relative;
    overflow: hidden;
  }

  .image-before img,
  .image-after img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .realisation-card:hover .image-before img,
  .realisation-card:hover .image-after img {
    transform: scale(1.05);
  }

  .image-label {
    position: absolute;
    bottom: var(--spacing-sm);
    left: var(--spacing-sm);
    background-color: rgba(0, 0, 0, 0.7);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .image-before .image-label {
    background-color: var(--color-gray-700);
  }

  .image-after .image-label {
    background-color: var(--color-primary);
  }

  .realisation-content {
    padding: var(--spacing-lg);
  }

  .realisation-location {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--text-sm);
    color: var(--color-gray-500);
    margin-bottom: var(--spacing-sm);
  }

  .realisation-location svg {
    color: var(--color-secondary);
  }

  .realisation-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-gray-900);
    margin-bottom: var(--spacing-sm);
  }

  .realisation-description {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin-bottom: var(--spacing-md);
  }

  .realisation-services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-md);
  }

  .service-tag {
    background-color: var(--color-gray-100);
    color: var(--color-gray-700);
    font-size: var(--text-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    border-radius: var(--radius-full);
  }

  .realisation-budget {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    padding-top: var(--spacing-sm);
    border-top: 1px solid var(--color-gray-100);
    margin-bottom: var(--spacing-md);
  }

  .realisation-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .realisation-link:hover {
    color: var(--color-secondary);
  }

  .realisation-link svg {
    transition: transform var(--transition-fast);
  }

  .realisation-link:hover svg {
    transform: translateX(4px);
  }
</style>
