---
/**
 * Composant ProcessSteps - Processus en etapes visuelles
 * Affiche le deroulement des travaux de maniere claire
 */

interface Step {
  number: string;
  title: string;
  description: string;
  icon: string;
}

interface Props {
  title?: string;
  steps?: Step[];
}

const defaultSteps: Step[] = [
  {
    number: '1',
    title: 'Contact et rendez-vous',
    description: 'Contactez-nous par telephone ou formulaire. Nous convenons d\'un rendez-vous rapide a votre domicile.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>`
  },
  {
    number: '2',
    title: 'Diagnostic et devis gratuit',
    description: 'Notre expert evalue l\'etat de votre toiture et etablit un devis detaille gratuit sous 24h.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
      <line x1="16" y1="13" x2="8" y2="13"/>
      <line x1="16" y1="17" x2="8" y2="17"/>
      <polyline points="10 9 9 9 8 9"/>
    </svg>`
  },
  {
    number: '3',
    title: 'Planification des travaux',
    description: 'Une fois le devis accepte, nous planifions l\'intervention selon vos disponibilites.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>`
  },
  {
    number: '4',
    title: 'Realisation et controle',
    description: 'Nos artisans realisent les travaux avec soin. Verification finale et remise des documents de garantie.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="9 11 12 14 22 4"/>
      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
    </svg>`
  }
];

const { title = 'Comment ca se passe ?', steps = defaultSteps } = Astro.props;
---

<section class="process-section">
  <div class="container">
    <div class="section-title">
      <h2>{title}</h2>
      <p>Un processus simple et transparent pour vos travaux de toiture</p>
    </div>

    <div class="process-steps">
      {steps.map((step, index) => (
        <div class="step" data-step={index}>
          <div class="step-number">{step.number}</div>
          <div class="step-icon" set:html={step.icon} />
          <div class="step-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
          {index < steps.length - 1 && <div class="step-connector" />}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: var(--spacing-3xl) 0;
    background-color: var(--color-gray-50);
  }

  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    position: relative;
  }

  .step {
    position: relative;
    text-align: center;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }

  .step.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .step-number {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--spacing-sm);
    background-color: var(--color-secondary);
    color: var(--color-gray-900);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .step-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--spacing-md);
    padding: var(--spacing-md);
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .step-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .step-content h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--spacing-sm);
    color: var(--color-gray-900);
  }

  .step-content p {
    font-size: var(--text-sm);
    color: var(--color-gray-600);
    line-height: 1.6;
    margin: 0;
  }

  .step-connector {
    display: none;
  }

  @media (min-width: 769px) {
    .step-connector {
      display: block;
      position: absolute;
      top: 24px;
      left: calc(50% + 24px);
      right: calc(-100% + 50% - 24px);
      height: 2px;
      background: linear-gradient(
        to right,
        var(--color-secondary) 0%,
        var(--color-gray-300) 100%
      );
    }

    .step:last-child .step-connector {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .process-steps {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-2xl);
    }
  }

  @media (max-width: 640px) {
    .process-steps {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
    }
  }
</style>

<script>
  const observerOptions = {
    threshold: 0.3,
    rootMargin: '0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        const step = entry.target as HTMLElement;
        const stepIndex = parseInt(step.dataset.step || '0');

        setTimeout(() => {
          step.classList.add('visible');
        }, stepIndex * 150);

        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.step').forEach((step) => {
    observer.observe(step);
  });
</script>
