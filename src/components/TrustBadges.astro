---
/**
 * Composant TrustBadges - Badges de confiance
 * Certifications, garanties et elements de reassurance
 */
---

<section class="trust-badges">
  <div class="container">
    <div class="badges-grid">
      <div class="badge">
        <div class="badge-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="badge-content">
          <strong>Garantie decennale</strong>
          <span>Protection 10 ans</span>
        </div>
      </div>

      <div class="badge">
        <div class="badge-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="8" r="7"/>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
          </svg>
        </div>
        <div class="badge-content">
          <strong>Artisan certifie RGE</strong>
          <span>Qualibat</span>
        </div>
      </div>

      <div class="badge">
        <div class="badge-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div class="badge-content">
          <strong>Devis sous 24h</strong>
          <span>100% gratuit</span>
        </div>
      </div>

      <div class="badge">
        <div class="badge-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
        </div>
        <div class="badge-content">
          <strong>15 ans d'experience</strong>
          <span>Expertise locale</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-badges {
    background-color: var(--color-gray-50);
    padding: var(--spacing-xl) 0;
    border-top: 1px solid var(--color-gray-200);
    border-bottom: 1px solid var(--color-gray-200);
  }

  .badges-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
  }

  .badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .badge-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-md);
  }

  .badge-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .badge-content strong {
    font-size: var(--text-sm);
    color: var(--color-gray-900);
  }

  .badge-content span {
    font-size: var(--text-xs);
    color: var(--color-gray-500);
  }

  @media (max-width: 1024px) {
    .badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .badges-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
