---
/**
 * Composant RelatedZones - Maillage interne vers les zones
 * Affiche les zones d'intervention pour renforcer le SEO local
 * A utiliser sur les pages de services
 */

import { cities } from '../utils/seo';

interface Props {
  title?: string;
  serviceName?: string;
}

const {
  title = "Zones d'intervention",
  serviceName = "ce service"
} = Astro.props;
---

<section class="related-zones">
  <div class="container">
    <h2>{title}</h2>
    <p class="related-intro">
      Nous proposons {serviceName} sur Dunkerque et tout le littoral nord.
      Selectionnez votre commune pour en savoir plus.
    </p>
    <div class="zones-grid">
      {cities.map(city => (
        <a href={`/zones/${city.slug}/`} class="zone-link">
          <span class="zone-name">{city.name}</span>
          <span class="zone-code">{city.postalCode}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related-zones {
    background-color: var(--color-gray-50);
    padding: var(--spacing-2xl) 0;
  }

  .related-zones h2 {
    text-align: center;
    margin-bottom: var(--spacing-sm);
  }

  .related-intro {
    text-align: center;
    color: var(--color-gray-600);
    margin-bottom: var(--spacing-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .zones-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .zone-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-lg);
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .zone-link:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .zone-name {
    font-weight: 600;
    color: var(--color-primary);
  }

  .zone-code {
    font-size: var(--text-sm);
    color: var(--color-gray-500);
  }

  @media (max-width: 1024px) {
    .zones-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .zones-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
