---
/**
 * Composant Hero - Section principale avec CTA
 * Au-dessus de la ligne de flottaison pour conversion maximale
 */

import Button from './Button.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  showForm?: boolean;
  backgroundImage?: string;
}

const {
  title,
  subtitle,
  description,
  showForm = true,
  backgroundImage = '/images/hero-toiture.webp'
} = Astro.props;
---

<section class="hero">
  <div class="hero-background" style={`background-image: url(${backgroundImage})`}></div>
  <div class="hero-overlay"></div>

  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        {subtitle && <span class="hero-badge">{subtitle}</span>}
        <h1>{title}</h1>
        <p class="hero-description">{description}</p>

        <div class="hero-features">
          <div class="feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Devis gratuit sous 24h</span>
          </div>
          <div class="feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Artisan certifie RGE</span>
          </div>
          <div class="feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Intervention rapide</span>
          </div>
        </div>

        <div class="hero-cta">
          <Button href="tel:+33328000000" variant="primary" size="lg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            03 28 00 00 00
          </Button>
          <Button href="/contact/" variant="outline" size="lg">
            Demander un devis
          </Button>
        </div>
      </div>

      {showForm && (
        <div class="hero-form">
          <ContactForm compact={true} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    padding: var(--spacing-3xl) 0;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(30, 58, 95, 0.95) 0%,
      rgba(30, 58, 95, 0.8) 100%
    );
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--spacing-2xl);
    align-items: center;
  }

  .hero-content {
    color: var(--color-white);
  }

  .hero-badge {
    display: inline-block;
    background-color: var(--color-secondary);
    color: var(--color-gray-900);
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--spacing-xs) var(--spacing-md);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-md);
  }

  .hero h1 {
    font-size: var(--text-5xl);
    color: var(--color-white);
    margin-bottom: var(--spacing-lg);
    line-height: 1.1;
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-gray-200);
    margin-bottom: var(--spacing-xl);
    line-height: 1.7;
  }

  .hero-features {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xl);
  }

  .feature {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-gray-200);
  }

  .feature svg {
    color: var(--color-secondary);
    flex-shrink: 0;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .hero-cta .btn-outline {
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .hero-cta .btn-outline:hover {
    background-color: var(--color-white);
    color: var(--color-primary);
  }

  .hero-form {
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl);
    box-shadow: var(--shadow-xl);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-form {
      max-width: 500px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--spacing-2xl) 0;
    }

    .hero h1 {
      font-size: var(--text-3xl);
    }

    .hero-cta {
      flex-direction: column;
    }

    .hero-cta .btn {
      width: 100%;
    }
  }
</style>
